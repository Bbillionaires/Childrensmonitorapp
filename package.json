{
  "name": "childrensmonitorapp",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "dotenv -e .env -- pnpm --filter @app/database db:migrate",
    "db:generate": "dotenv -e .env -- pnpm --filter @app/database db:generate",
    "db:seed": "dotenv -e .env -- pnpm --filter @app/database db:seed"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
