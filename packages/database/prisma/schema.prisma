// Full domain schema — see /DATABASE_SCHEMA.md for the human-readable map of this file.
// Milestone 1 wires up business logic only for the tables marked [M1] there
// (User, ParentAccount, Child, Device, AuditLog). Everything else is created now so later
// milestones never need a destructive migration to introduce a missing concept.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & accounts [M1]
// ---------------------------------------------------------------------------

enum UserRole {
  PARENT
  ADMIN
  SCHOOL_ADMIN
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(PARENT)
  emailVerifiedAt     DateTime?
  mfaEnabled          Boolean   @default(false)
  mfaSecretEncrypted  String?
  pinHash             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastLoginAt         DateTime?

  parentAccount       ParentAccount?
  schoolAdminAccount  SchoolAdminAccount?
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model ParentAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  children           Child[]
  devices            Device[]
  playlists          Playlist[]
  parentApprovals    ParentApproval[]
  parentReports      ParentReport[]
  searchRequests     SearchRequest[]
  firstImportedContent Content[]
  contentSubmissions ContentSubmission[]
  subscription       ParentSubscription?

  // Milestone 11: a parent whose access comes from a school's seat-based subscription rather
  // than (or in addition to — a personal subscription is left alone if they have one) their
  // own. Entitlement checks (subscription-gate.ts) treat "on an entitled school's seat" as an
  // alternative to "has an entitled ParentSubscription", never a replacement for the column.
  schoolAccountId    String?
  schoolAccount      SchoolAccount?    @relation(fields: [schoolAccountId], references: [id], onDelete: SetNull)
  acceptedSchoolSeatInvite SchoolSeatInvite?

  @@map("parent_accounts")
}

enum AgeRange {
  AGE_3_5
  AGE_6_8
  AGE_9_12
  AGE_13_15
  AGE_16_17
}

model Child {
  id                          String    @id @default(cuid())
  parentAccountId             String
  parentAccount               ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  firstName                   String
  avatarUrl                   String?
  ageRange                    AgeRange?
  birthYear                   Int?
  interests                   String[] @default([])
  contentCategories            String[] @default([])
  supervisionScoreMinimum     Int       @default(900)
  categoryThresholdOverrides  Json?
  dailyLimitMinutes           Int?
  // Milestone 11: opt-in structured learning queue (see LearningQueueState) — off by default,
  // so every child not explicitly enrolled keeps today's free-choice approved library exactly
  // as it was. gateEnforced only matters while the mode itself is enabled: hard-locks the next
  // fun videos behind the required learning video rather than just suggesting it.
  structuredLearningModeEnabled   Boolean @default(false)
  structuredLearningGateEnforced  Boolean @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  archivedAt                  DateTime?

  devices              Device[]
  parentApprovals      ParentApproval[]
  contentPermissions   ChildContentPermission[]
  viewingHistory       ViewingHistory[]
  screenTimeRule       ScreenTimeRule?
  safetyAlerts         SafetyAlert[]
  parentReports        ParentReport[]
  searchRequests       SearchRequest[]
  learningQueueStates  LearningQueueState[]

  @@index([parentAccountId])
  @@map("children")
}

enum DevicePlatform {
  WEB
  IOS
  ANDROID
  TV
}

model Device {
  id               String          @id @default(cuid())
  parentAccountId  String
  parentAccount    ParentAccount   @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  childId          String?
  child            Child?          @relation(fields: [childId], references: [id], onDelete: SetNull)
  label            String
  platform         DevicePlatform  @default(WEB)
  lastSeenAt       DateTime?
  createdAt        DateTime        @default(now())
  revokedAt        DateTime?

  refreshTokens    RefreshToken[]
  viewingHistory   ViewingHistory[]
  // Milestone 11: one handoff session = one Device row (see child-session-service.ts's own
  // comment on this) = one fresh structured-learning-queue decay, started lazily on first use.
  learningQueueState LearningQueueState?

  @@index([parentAccountId])
  @@index([childId])
  @@map("devices")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole    String
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Content domain (Milestone 2+)
// ---------------------------------------------------------------------------

model ContentProvider {
  id                 String    @id // e.g. "youtube", "vimeo", "website"
  displayName        String
  apiBaseUrl         String?
  requiresOfficialApi Boolean  @default(true)
  enabled            Boolean   @default(true)

  content Content[]

  @@map("content_providers")
}

enum ContentType {
  VIDEO
  WEBSITE
}

model Content {
  id                          String       @id @default(cuid())
  providerId                  String
  provider                    ContentProvider @relation(fields: [providerId], references: [id])
  providerRefId               String
  contentType                 ContentType
  sourceUrl                   String
  title                       String
  description                 String?
  thumbnailUrl                String?
  durationSeconds             Int?
  creatorName                 String?
  providerMadeForKids         Boolean?
  rawMetadata                 Json?
  firstImportedByParentAccountId String?
  firstImportedByParentAccount ParentAccount? @relation(fields: [firstImportedByParentAccountId], references: [id], onDelete: SetNull)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  video                Video?
  website              Website?
  playlistItems        PlaylistItem[]
  parentApprovals      ParentApproval[]
  contentPermissions   ChildContentPermission[]
  viewingHistory       ViewingHistory[]
  supervisionScore     SupervisionScore?
  scoreVersions        ScoreVersion[]
  safetyAlerts         SafetyAlert[]
  parentReports        ParentReport[]
  aiRecommendations    AIRecommendation[]
  submissions          ContentSubmission[]
  apiUsageLogs         ApiUsageLog[]

  @@unique([providerId, providerRefId])
  @@map("content")
}

// Content is deduplicated globally by (providerId, providerRefId) — see the note on Content
// above — so a second, unrelated parent submitting the same public video reuses the same
// metadata row rather than re-fetching the provider API. That means Content on its own
// cannot answer "what has this parent submitted" (only firstImportedByParentAccountId, i.e.
// whoever happened to be first, could). ContentSubmission is the many-to-many record of
// every parent account's own submission queue, independent of who imported it first — this
// is what "Pending Reviews" and "my submitted content" are actually queried against.
model ContentSubmission {
  id               String        @id @default(cuid())
  parentAccountId  String
  parentAccount    ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  contentId        String
  content          Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  submittedByUserId String?
  createdAt        DateTime      @default(now())

  @@unique([parentAccountId, contentId])
  @@index([parentAccountId])
  @@map("content_submissions")
}

model Video {
  id                    String    @id @default(cuid())
  contentId             String    @unique
  content               Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  captionsAvailable     Boolean   @default(false)
  transcriptFetchedAt   DateTime?
  ageMetadataRaw        Json?

  @@map("videos")
}

model Website {
  id                       String  @id @default(cuid())
  contentId                String  @unique
  content                  Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  allowedDomain            String
  allowedPathPrefix        String?
  blockExternalNavigation  Boolean @default(true)

  @@map("websites")
}

model Playlist {
  id                 String   @id @default(cuid())
  providerId         String?
  providerRefId      String?
  ownerParentAccountId String
  ownerParentAccount ParentAccount @relation(fields: [ownerParentAccountId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items PlaylistItem[]

  // Scoped per-parent (unlike Content, which dedupes globally) — a playlist is each
  // parent's own organizational object, so re-importing the same provider playlist
  // refreshes *that parent's* Playlist row rather than ever being shared across families.
  @@unique([ownerParentAccountId, providerId, providerRefId])
  @@index([ownerParentAccountId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  contentId  String
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())

  viewingHistory ViewingHistory[]

  @@unique([playlistId, contentId])
  @@index([playlistId])
  @@map("playlist_items")
}

// ---------------------------------------------------------------------------
// Approval domain (Milestone 2+)
// ---------------------------------------------------------------------------

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ApprovalSource {
  MANUAL
  AI_DISCOVERY
  PLAYLIST_IMPORT
  AUTO_RULE
}

model ParentApproval {
  id               String           @id @default(cuid())
  parentAccountId  String
  parentAccount    ParentAccount    @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  childId          String
  child            Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentId        String
  content          Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  decision         ApprovalDecision
  decidedAt        DateTime         @default(now())
  decidedByUserId  String?
  source           ApprovalSource   @default(MANUAL)
  notes            String?

  contentPermission ChildContentPermission?

  @@unique([childId, contentId])
  @@index([parentAccountId])
  @@index([childId])
  @@map("parent_approvals")
}

enum SchoolSubject {
  MATH
  READING
  SCIENCE
  SOCIAL_STUDIES
  LANGUAGE_ARTS
  OTHER
}

model ChildContentPermission {
  id            String         @id @default(cuid())
  childId       String
  child         Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentId     String
  content       Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  grantedAt     DateTime       @default(now())
  grantedViaId  String         @unique
  grantedVia    ParentApproval @relation(fields: [grantedViaId], references: [id], onDelete: Cascade)
  // Milestone 11: manually tagged by whoever approves the content (see approval-service.ts),
  // not AI-inferred. The structured learning queue (LearningQueueState) reads these two fields
  // directly off the grant a child's library already queries, rather than joining back through
  // ParentApproval for them.
  isLearningContent Boolean      @default(false)
  subject           SchoolSubject?

  @@unique([childId, contentId])
  @@index([childId])
  @@map("child_content_permissions")
}

// ---------------------------------------------------------------------------
// Viewing (Milestone 3/6)
// ---------------------------------------------------------------------------

model ViewingHistory {
  id                     String        @id @default(cuid())
  childId                String
  child                  Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentId              String
  content                Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  deviceId               String?
  device                 Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  playlistItemId         String?
  playlistItem           PlaylistItem? @relation(fields: [playlistItemId], references: [id], onDelete: SetNull)
  startedAt              DateTime      @default(now())
  durationWatchedSeconds Int           @default(0)
  completionPercentage   Float         @default(0)

  @@index([childId])
  @@index([contentId])
  @@map("viewing_history")
}

// Milestone 11: per-(child, device-handoff-session) decay state for the structured learning
// queue — see SCHOOL_SEATS.md. A new Device row (a new handoff) has no matching row here yet,
// so `getOrCreateQueueState` lazily creates one at stepIndex 0, which is exactly how "the
// 3-fun-then-1-learning arc restarts every new session" is implemented: there is deliberately
// no cross-session persistence, only cross-request persistence *within* one still-live Device.
model LearningQueueState {
  id               String   @id @default(cuid())
  deviceId         String   @unique
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  childId          String
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  // 0 -> 3 fun videos before a learning video is due, 1 -> 2, 2+ -> 1 (holds for the rest of
  // this session once it gets there — see learning-queue-service.ts's FUN_QUOTA_BY_STEP).
  stepIndex        Int      @default(0)
  funWatchedInStep Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("learning_queue_states")
}

model ScreenTimeRule {
  id               String   @id @default(cuid())
  childId          String   @unique
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyLimitMinutes Int?
  allowedWindows   Json?
  timezone         String   @default("UTC")

  @@map("screen_time_rules")
}

// ---------------------------------------------------------------------------
// Safety domain (Milestone 5/6)
// ---------------------------------------------------------------------------

model SafetyCategory {
  id          String  @id // e.g. "violence", "grooming_indicators"
  displayName String
  description String?
  weight      Float   @default(1.0)

  categoryResults ScoreCategoryResult[]

  @@map("safety_categories")
}

model SupervisionScore {
  id                    String      @id @default(cuid())
  contentId             String      @unique
  content               Content     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  currentScoreVersionId String      @unique
  currentScoreVersion   ScoreVersion @relation("CurrentVersion", fields: [currentScoreVersionId], references: [id])

  @@map("supervision_scores")
}

model ScoreVersion {
  id                     String    @id @default(cuid())
  contentId              String
  content                Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  modelVersion           String
  overallScore           Int
  confidence             Float
  analyzedAt             DateTime  @default(now())
  signalsUsed            Json
  explanation            String
  previousScoreVersionId String?   @unique
  previousScoreVersion   ScoreVersion? @relation("VersionHistory", fields: [previousScoreVersionId], references: [id])
  nextScoreVersion       ScoreVersion? @relation("VersionHistory")

  categoryResults        ScoreCategoryResult[]
  currentFor             SupervisionScore?     @relation("CurrentVersion")
  safetyAlertsFrom        SafetyAlert[]         @relation("PreviousScoreVersion")
  safetyAlertsTo          SafetyAlert[]         @relation("NewScoreVersion")

  @@index([contentId])
  @@map("score_versions")
}

model ScoreCategoryResult {
  id               String         @id @default(cuid())
  scoreVersionId   String
  scoreVersion     ScoreVersion   @relation(fields: [scoreVersionId], references: [id], onDelete: Cascade)
  safetyCategoryId String
  safetyCategory   SafetyCategory @relation(fields: [safetyCategoryId], references: [id])
  score            Int
  confidence       Float
  detectedFactors  Json
  notes            String?

  @@index([scoreVersionId])
  @@map("score_category_results")
}

enum AlertType {
  NEW_SAFETY_INFO
  SCORE_DROPPED
  PROVIDER_FLAG_CHANGED
  PARENT_REPORT_VALIDATED
}

enum AlertStatus {
  OPEN
  KEPT_APPROVED
  REMOVED
}

model SafetyAlert {
  id                     String        @id @default(cuid())
  contentId              String
  content                Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  childId                String?
  child                  Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
  alertType              AlertType
  previousScoreVersionId String?
  previousScoreVersion   ScoreVersion? @relation("PreviousScoreVersion", fields: [previousScoreVersionId], references: [id])
  newScoreVersionId      String?
  newScoreVersion        ScoreVersion? @relation("NewScoreVersion", fields: [newScoreVersionId], references: [id])
  status                 AlertStatus   @default(OPEN)
  createdAt              DateTime      @default(now())
  resolvedAt             DateTime?
  resolvedByUserId       String?

  @@index([contentId])
  @@index([childId])
  @@map("safety_alerts")
}

enum ReportCategory {
  INAPPROPRIATE_CONTENT
  VIOLENCE
  SEXUAL_CONTENT
  DISTURBING_IMAGERY
  GROOMING_INDICATORS
  DANGEROUS_CHALLENGE
  MISLEADING_AGE_CLASSIFICATION
  ADVERTISING
  OTHER
}

enum ReportStatus {
  SUBMITTED
  REVIEWED
  VALIDATED
  DISMISSED
}

model ParentReport {
  id                       String        @id @default(cuid())
  reportingParentAccountId String
  reportingParentAccount   ParentAccount @relation(fields: [reportingParentAccountId], references: [id], onDelete: Cascade)
  contentId                String
  content                  Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  childId                  String?
  child                    Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)
  category                 ReportCategory
  details                  String?
  status                   ReportStatus  @default(SUBMITTED)
  createdAt                DateTime      @default(now())
  reviewedAt               DateTime?

  @@index([contentId])
  @@map("parent_reports")
}

// ---------------------------------------------------------------------------
// Discovery (Milestone 4)
// ---------------------------------------------------------------------------

model SearchRequest {
  id               String   @id @default(cuid())
  parentAccountId  String
  parentAccount    ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  childId          String?
  child            Child?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  rawQuery         String
  structuredQuery  Json
  createdAt        DateTime @default(now())

  recommendations AIRecommendation[]

  @@index([parentAccountId])
  @@map("search_requests")
}

enum RecommendationDecision {
  PENDING
  APPROVED
  REJECTED
}

model AIRecommendation {
  id              String                  @id @default(cuid())
  searchRequestId String
  searchRequest   SearchRequest           @relation(fields: [searchRequestId], references: [id], onDelete: Cascade)
  contentId       String
  content         Content                 @relation(fields: [contentId], references: [id], onDelete: Cascade)
  matchReason     String
  rank            Int
  presentedAt     DateTime                @default(now())
  parentDecision  RecommendationDecision  @default(PENDING)

  @@index([searchRequestId])
  @@map("ai_recommendations")
}

// ---------------------------------------------------------------------------
// Billing (Milestone 10) — two independent subscriptions: a parent's own access to this
// app, and a business's access to the commercial Supervision Score API. Both are Stripe
// Checkout subscriptions at prices configured in Stripe itself (not hardcoded here — see
// packages/billing and COMMERCIAL_API.md), kept in sync by webhook events rather than trusted
// client state, the same "server decides, never the client" principle as everywhere else in
// this schema.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model ParentSubscription {
  id                   String             @id @default(cuid())
  parentAccountId      String             @unique
  parentAccount        ParentAccount      @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("parent_subscriptions")
}

// A business/developer customer of the commercial Supervision Score API — never a parent or
// child in this app; completely separate identity space, see COMMERCIAL_API.md.
model ApiClient {
  id                   String             @id @default(cuid())
  name                 String
  contactEmail         String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  apiKeys   ApiKey[]
  usageLogs ApiUsageLog[]

  @@map("api_clients")
}

// Only a SHA-256 hash of the raw key is ever stored — same reasoning as
// RefreshToken.tokenHash/PasswordResetToken.tokenHash (see packages/auth's opaque-tokens.ts):
// a leaked database dump alone must never be replayable as a live key. `keyPrefix` is the raw
// key's own first few characters (not secret on its own) kept only so a client can recognize
// which key is which without ever seeing the full value again after issuance.
model ApiKey {
  id          String    @id @default(cuid())
  apiClientId String
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  keyPrefix   String
  keyHash     String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  usageLogs ApiUsageLog[]

  @@index([apiClientId])
  @@map("api_keys")
}

model ApiUsageLog {
  id          String    @id @default(cuid())
  apiClientId String
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  apiKeyId    String
  apiKey      ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint    String
  contentId   String?
  content     Content?  @relation(fields: [contentId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([apiClientId, createdAt])
  @@map("api_usage_logs")
}

// ---------------------------------------------------------------------------
// School seats (Milestone 11) — a THIRD, independent Stripe subscription besides a parent's
// own and a commercial API client's: a school pays a seat-based monthly subscription (Stripe
// subscription `quantity` = seats purchased) and distributes those seats to parents by email
// invite. A parent occupying a seat is never personally charged — their entitlement derives
// from SchoolAccount.status via ParentAccount.schoolAccountId (see subscription-gate.ts), not
// from their own ParentSubscription. See SCHOOL_SEATS.md.
// ---------------------------------------------------------------------------

// A school's own login identity — mirrors ParentAccount's relationship to User exactly, kept
// as a fully separate profile type (never a parent, never a child) per
// ARCHITECTURE.md's RBAC model.
model SchoolAdminAccount {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@map("school_admin_accounts")
}

model SchoolAccount {
  id                   String             @id @default(cuid())
  name                 String
  contactEmail         String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  // Always set from the Stripe subscription's own quantity at webhook time, never trusted
  // from a client request — see billing-service.ts's applySubscriptionEvent school branch.
  seatCount            Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  admins        SchoolAdminAccount[]
  parentAccounts ParentAccount[]
  seatInvites   SchoolSeatInvite[]

  @@map("school_accounts")
}

enum SchoolSeatInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Only a SHA-256 hash of the raw invite token is ever stored — same "shown once" discipline as
// PasswordResetToken/ApiKey — the raw token exists only in the email sent to the invited parent.
model SchoolSeatInvite {
  id                       String                 @id @default(cuid())
  schoolAccountId          String
  schoolAccount            SchoolAccount          @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)
  email                    String
  tokenHash                String                 @unique
  status                   SchoolSeatInviteStatus @default(PENDING)
  createdAt                DateTime               @default(now())
  expiresAt                DateTime
  acceptedAt               DateTime?
  acceptedByParentAccountId String?               @unique
  acceptedByParentAccount  ParentAccount?          @relation(fields: [acceptedByParentAccountId], references: [id], onDelete: SetNull)

  @@index([schoolAccountId])
  @@map("school_seat_invites")
}
