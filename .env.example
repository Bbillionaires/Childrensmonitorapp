# Copy to .env and fill in. See IMPLEMENTATION_PLAN.md for where each credential comes from.

# --- Database (required) ---
# Local dev: matches docker-compose.yml. Staging/prod: a managed Postgres provider
# (Railway, Supabase, RDS, etc.) — see IMPLEMENTATION_PLAN.md.
DATABASE_URL="postgresql://app:app@localhost:5432/childrensmonitorapp"

# --- Auth (required — generate locally, not a third-party account) ---
# e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="dev-only-change-me-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret-change-me"

# --- API server ---
API_PORT=4000
WEB_APP_ORIGIN="http://localhost:3000"

# --- Web app ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# --- Email (Milestone 1 password reset in non-local environments) ---
# Needed to actually deliver password-reset emails outside local dev.
# Get a key at https://resend.com (or any transactional email provider).
RESEND_API_KEY=""
EMAIL_FROM="Family Safety <no-reply@example.com>"

# --- Milestone 2: YouTube content provider ---
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=""

# --- Milestone 4: AI-assisted discovery (dual-provider: OpenAI primary, Claude fallback) ---
# Primary — every discovery search costs real money from this one shared/operator-funded key,
# so OpenAI's low-cost tier is used by default. https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional — override the default cost-tier model (gpt-5.4-mini). A cheaper option exists
# (gpt-5.4-nano) if volume ever calls for it.
OPENAI_MODEL=""
# Fallback only — used when OpenAI's call fails (outage, bad response). Not required if
# OPENAI_API_KEY is set, but recommended for resilience. https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=""
